{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "height": 720,
        "label": "main",
        "minHeight": 600,
        "minWidth": 480,
        "title": "whisperexe",
        "url": "main.html",
        "visible": true,
        "width": 560
      },
      {
        "alwaysOnTop": true,
        "decorations": false,
        "focus": false,
        "height": 128,
        "label": "overlay",
        "resizable": false,
        "skipTaskbar": true,
        "title": "whisperexe",
        "transparent": true,
        "url": "overlay.html",
        "visible": false,
        "width": 320
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "./ui"
  },
  "bundle": {
